# Bu dosyayı keystore.properties olarak kopyalayın (repoya EKLEMEYİN, .gitignore'da).
# Keystore oluşturmak için:
#   keytool -genkey -v -keystore havam-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias havam
storeFile=havam-release.jks
storePassword=CHANGE_ME
keyAlias=havam
keyPassword=CHANGE_ME
