<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ için yedekleme ve cihazdan cihaza aktarma kuralları (bkz. backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="favorites.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="favorites.xml" />
    </device-transfer>
</data-extraction-rules>
